# ============================================================
#  BACTERIA WAR 환경변수
#  Railway에서는 PostgreSQL 플러그인 추가 시 DATABASE_URL 자동 주입.
#  로컬 테스트 시 이 파일을 .env 로 복사해서 채우세요.
# ============================================================

# PostgreSQL 연결 (Railway가 자동 주입 / 로컬은 직접 설정)
DATABASE_URL=postgres://user:password@localhost:5432/bacteriawar

# 외부 DB(SSL 필요) 연결 시 true
PGSSL=false

# 서버 포트 (Railway가 자동 주입, 로컬 기본 3000)
PORT=3000
